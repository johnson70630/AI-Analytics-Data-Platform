flowchart TB
    subgraph PLATFORM["DAILY DATA PLATFORM · SCHEDULED"]
        direction LR
        EVENTS["Synthetic product, model<br/>and finance events"] --> LF["Lakeflow Jobs<br/>daily orchestration"]
        LF --> GEN["Deterministic Python / Spark<br/>generator + clean source state"]
        GEN --> BRONZE["Delta Bronze<br/>append-only records"]
        BRONZE --> STAGING["dbt Staging<br/>typed + deduplicated"]
        STAGING --> SILVER["Silver<br/>dimensions · SCD2 · facts"]
        SILVER --> GOLD["Gold<br/>business marts"]
        GOLD --> AIBI["Databricks AI/BI"]
        STAGING --> OBS["Observability<br/>freshness · volume · quality · reconciliation"]
        SILVER --> OBS
        GOLD --> OBS
        UC["Unity Catalog<br/>governance · PII · least privilege"] -. "governs" .-> BRONZE
        LF --> OUT["Execution metadata +<br/>observability checks"]
        OBS --> OUT
    end

    OUT --> EVIDENCE["READ-ONLY EVIDENCE<br/>Jobs API + fixed observability SQL<br/>run ↔ monitoring association remains UNVERIFIED"]

    subgraph DATAOPS["DATAOPS EXPERIENCE · USER TRIGGERED"]
        direction LR
        IN["Operational evidence"] --> HEALTH["Daily Health Review<br/>Manual Refresh · no LLM or Genie"]
        IN --> GRAPH["LangGraph investigation<br/>parallel evidence collection"]

        USER["DataOps user"] --> CMD["DataOps AI<br/>Command Center"]
        CMD --> HEALTH
        CMD -->|"Chat"| MODEL["GPT OSS 120B<br/>declared model service"]
        MODEL --> TOOLS["Four read-only tools<br/>get_latest_pipeline_run<br/>get_latest_observability_summary<br/>ask_genie_observability<br/>generate_dataops_investigation_report"]
        CMD -->|"Run Full Investigation<br/>one user action"| COMPOSITE["generate_dataops_<br/>investigation_report"]
        TOOLS -. "same fixed tool" .-> COMPOSITE
        COMPOSITE --> GRAPH
        GRAPH -->|"0–2 bounded questions"| GENIE["Databricks Genie<br/>historical queries"]
        GENIE --> RECS["Deterministic P0–P3<br/>evidence-linked recommendations"]
        GRAPH --> RECS
        RECS --> REPORT["InvestigationReport v1.1<br/>unknowns + approval labels"]
        REPORT --> VIEWER["Evidence-rich<br/>report viewer"]

        RUNTIME["Runtime Store<br/>invocation recovery"] --> AB["Agent Bricks runtime"]
        SESSION["Session Store<br/>conversation state"] --> AB
        AB --> CMD
        AB --> MLFLOW["MLflow tracing<br/>metadata recorded"]
    end

    EVIDENCE --> IN

