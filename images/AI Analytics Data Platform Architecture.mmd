flowchart TB
    LF["DATABRICKS LAKEFLOW JOBS<br/>Daily 2:00 AM America/Los_Angeles · 9-task dependency graph<br/>Serverless Jobs + SQL Warehouse · retry-safe · monitored"]

    subgraph SCHEDULED["SCHEDULED DATA PLATFORM"]
        direction LR
        GEN["1 · SYNTHETIC GENERATOR<br/>Python / Spark<br/>deterministic daily events"]
        SOURCE["2 · SOURCE STATE<br/>ai_analytics.source<br/>clean operational state"]
        BRONZE["3 · BRONZE<br/>ai_analytics.bronze<br/>append-only Delta + controlled defects"]
        STAGING["4 · DBT STAGING<br/>ai_analytics.staging<br/>typed · deduplicated · quality flags"]
        PII["5 · PII / USER STATE<br/>ai_analytics.pii<br/>current + historical user state"]
        SNAP["6 · SCD2 SNAPSHOT<br/>ai_analytics.snapshots<br/>dim_user_snapshot"]
        SILVER["7 · SILVER<br/>ai_analytics.silver<br/>dimensions · 9 facts · MERGE"]
        GOLD["8 · GOLD<br/>ai_analytics.gold<br/>4 governed business marts"]
        OBS["9 · OBSERVABILITY<br/>ai_analytics.observability<br/>freshness · volume · quality · reconciliation"]
        GEN --> SOURCE
        SOURCE --> BRONZE
        BRONZE --> STAGING
        STAGING --> PII
        PII --> SNAP
        SNAP --> SILVER
        SILVER --> GOLD
        GOLD --> OBS
    end

    LF --> GEN
    GOLD --> AIBI["Databricks AI/BI<br/>governed Gold dashboards"]
    STAGING --> OBS
    SILVER --> OBS
    GOLD --> OBS

    EVIDENCE["READ-ONLY OPERATIONAL EVIDENCE<br/>Jobs execution metadata + latest deterministic observability snapshot<br/>pipeline ↔ monitoring association remains UNVERIFIED"]
    LF --> EVIDENCE
    OBS --> EVIDENCE

    subgraph DATAOPS["USER-TRIGGERED DATAOPS · NO SCHEDULED AI INVESTIGATION"]
        direction LR
        CMD["10 · DATABRICKS APP / AGENT BRICKS<br/>DataOps AI Command Center<br/>Daily Health Review · Manual Refresh"]
        TOOLS["11 · FOUR READ-ONLY TOOLS<br/>Execution health — get_latest_pipeline_run<br/>Latest data health — get_latest_observability_summary<br/>Historical questions — ask_genie_observability<br/>Full investigation — generate_dataops_investigation_report"]
        GRAPH["12 · LANGGRAPH INVESTIGATION<br/>one explicit user action<br/>parallel Jobs + observability collection<br/>0–2 bounded Genie historical questions"]
        REPORT["13 · REPORT v1.1<br/>evidence-linked findings<br/>P0–P3 advisory recommendations<br/>unknowns + approval labels preserved"]
        CMD -->|"Chat through GPT OSS 120B"| TOOLS
        CMD -->|"Run Full Investigation"| GRAPH
        TOOLS -. "fixed composite tool" .-> GRAPH
        GRAPH --> REPORT
    end

    EVIDENCE --> CMD
    EVIDENCE --> GRAPH
    GRAPH --> GENIE["Databricks Genie<br/>bounded historical investigations"]
    MODEL["GPT OSS 120B<br/>declared model service"] --> CMD
    REPORT --> VIEWER["Evidence-rich viewer<br/>issues · Genie evidence · verification"]
    SESSION["Managed Session Store<br/>conversation state"] --> CMD
    RUNTIME["Managed Runtime Store<br/>invocation recovery"] --> CMD

    UC["UNITY CATALOG GOVERNANCE<br/>source · bronze · staging · pii · snapshots · silver · gold · observability<br/>schema isolation · least privilege · lineage"]
    UC -. "governs" .-> SOURCE
    UC -. "governs" .-> OBS
    UC -. "governs" .-> EVIDENCE

    DEPLOY["DEPLOYMENT<br/>Databricks Asset Bundles · Agent Bricks · one Medium App instance"]
    COMPUTE["SERVERLESS COMPUTE<br/>Jobs compute · SQL Warehouse"]
    DEPLOY -.-> LF
    DEPLOY -.-> CMD
    COMPUTE -.-> LF

    METRICS["VALIDATED CLOUD RESULTS<br/>9/9 Lakeflow tasks passed · 48 monitoring checks (44 PASS · 4 WARN · 0 FAIL)<br/>2 bounded Genie investigations · 12 evidence-linked recommendations"]

    classDef lake fill:#eaf3ff,stroke:#2563eb,color:#102a56,stroke-width:2px;
    classDef source fill:#f2edff,stroke:#7c3aed,color:#2e1065,stroke-width:1.5px;
    classDef delta fill:#fff4e8,stroke:#f59e0b,color:#78350f,stroke-width:1.5px;
    classDef transform fill:#eaf6ff,stroke:#0284c7,color:#0c4a6e,stroke-width:1.5px;
    classDef governed fill:#ecfdf3,stroke:#16a34a,color:#14532d,stroke-width:1.5px;
    classDef agent fill:#f4ecff,stroke:#7c3aed,color:#3b0764,stroke-width:1.5px;
    classDef evidence fill:#fff7df,stroke:#d97706,color:#713f12,stroke-width:1.5px;
    classDef infra fill:#f8fafc,stroke:#64748b,color:#1e293b,stroke-width:1.5px;
    classDef result fill:#edfdf6,stroke:#059669,color:#064e3b,stroke-width:2px;

    class LF lake;
    class GEN,SOURCE source;
    class BRONZE delta;
    class STAGING transform;
    class PII,SNAP,SILVER,GOLD,OBS,AIBI,UC governed;
    class CMD,TOOLS,GRAPH,REPORT,GENIE,MODEL,VIEWER agent;
    class EVIDENCE evidence;
    class SESSION,RUNTIME,DEPLOY,COMPUTE infra;
    class METRICS result;

    style SCHEDULED fill:#fbfdff,stroke:#60a5fa,stroke-width:2px,color:#102a56
    style DATAOPS fill:#fdfaff,stroke:#a78bfa,stroke-width:2px,color:#3b0764
