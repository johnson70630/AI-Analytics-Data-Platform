# Copy to .env for local development:  cp .env.example .env
#
# Local model and tool calls use a Databricks profile. Invocation durability is in memory under
# `agentbricks dev`; managed Session and Memory Store bindings take effect after deployment.

# Local authentication (from `databricks auth profiles`). Deployed Apps use their workload identity.
DATABRICKS_CONFIG_PROFILE=DEFAULT

# Required by the four read-only DataOps tools. Use identifiers only; never place credentials here.
DATABRICKS_PIPELINE_JOB_ID=
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_GENIE_AGENT_ID=

# --- Optional: MLflow tracing ---
# `agentbricks dev` supplies its local tracing configuration. For direct runtime execution, set a
# destination AND an experiment: MLFLOW_TRACKING_URI or MLFLOW_TRACING_DESTINATION, plus
# MLFLOW_EXPERIMENT_ID or MLFLOW_EXPERIMENT_NAME.
# MLFLOW_TRACKING_URI="databricks"
# MLFLOW_EXPERIMENT_ID=
# MLFLOW_EXPERIMENT_NAME=
# For fully-local tracing (no workspace), point MLFLOW_TRACKING_URI at a local OSS MLflow server
# (`mlflow server`), e.g. MLFLOW_TRACKING_URI="http://localhost:5000".

# --- Optional: long-term memory tools ---
# Leave UNSET to skip. Set to a managed memory store ID to register the remember/recall tools
# (persist/search facts across conversations); see databricks_agentkit/langgraph/memory.py. Memory is
# partitioned by the trusted actor resolved by the runtime adapter.
# AGENT_MEMORY_STORE=<memory-store-id>

# --- Optional: durable state (managed Session Store) ---
# Leave UNSET to keep the in-process LangGraph checkpointer (InMemorySaver): multi-turn and HITL
# pauses work within one process but don't survive restarts/replicas. Set to a managed
# Session Store name to persist checkpoints through its REST API (DatabricksSessionStoreSaver) —
# durable graph state incl. paused HITL runs, over RPCs (no DB connection). Access uses your normal
# Databricks auth (must have access to the store). See databricks_agentkit/langgraph/session_store.py.
# AGENT_SESSION_STORE=my-agent-sessions

# --- LangGraph Studio only ---
# Studio defaults this to false in agent/investigation/studio.py. Set true only when explicitly
# choosing LangSmith cloud tracing for local graph development.
# LANGSMITH_TRACING=false
