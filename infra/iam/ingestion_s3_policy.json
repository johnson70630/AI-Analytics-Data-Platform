{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBronzePartitions",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${S3_BUCKET_NAME}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "bronze/*"
        }
      }
    },
    {
      "Sid": "ReadBronzeObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${S3_BUCKET_NAME}/bronze/*"
    }
  ]
}
