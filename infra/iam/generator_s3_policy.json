{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListApprovedGeneratorPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${S3_BUCKET_NAME}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "raw/*",
            "bronze/*",
            "quality/injection_manifest/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadApprovedGeneratorObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET_NAME}/raw/*",
        "arn:aws:s3:::${S3_BUCKET_NAME}/bronze/*",
        "arn:aws:s3:::${S3_BUCKET_NAME}/quality/injection_manifest/*"
      ]
    },
    {
      "Sid": "WriteApprovedGeneratorObjects",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET_NAME}/raw/*",
        "arn:aws:s3:::${S3_BUCKET_NAME}/bronze/*",
        "arn:aws:s3:::${S3_BUCKET_NAME}/quality/injection_manifest/*"
      ]
    }
  ]
}
